NODE_ENV=development
# Explicit mobile test mode on the hosted site; keeps HTTPS and uses the development database.
# DEMO_MODE=true
# In hosted mobile test mode set DATABASE_PATH=./data/development.sqlite.
PORT=4312
# 开发默认允许局域网访问；设为 127.0.0.1 可恢复仅本机访问。
# BIND_HOST=0.0.0.0
# production 始终监听 127.0.0.1，不受 BIND_HOST 或 DEMO_MODE 影响。
DATABASE_PATH=./data/development.sqlite
PUBLIC_ORIGIN=http://127.0.0.1:4312
SMS_PROVIDER=development
MAP_PROVIDER=manual
UPLOAD_PROVIDER=local
# Production must use a separate database and configured SMS delivery.
# SMS_WEBHOOK_URL=https://your-sms-adapter.example/send
# SMS_WEBHOOK_TOKEN=replace-with-server-side-secret
# 百度地图网页接入：将 MAP_PROVIDER 改为 baidu，取消下一行注释并填写浏览器类型 AK。
# 本地 Referer 白名单：127.0.0.1,localhost；手机调试添加电脑局域网 IP，上线添加正式域名。
# 修改环境变量后需要重启应用。浏览器 AK 按 SDK 要求公开，并应限制可调用域名。
# BAIDU_MAP_BROWSER_AK=
# 服务端 AK 为后续路线适配预留，不发送给浏览器。
# BAIDU_MAP_SERVER_AK=
# COS_BUCKET=
# COS_REGION=
# COS_SECRET_ID=
# COS_SECRET_KEY=
# BACKUP_DIR=./backups
# 兑换封面：开发和测试保存到各自的数据目录；production 使用以上 COS 配置。
